# Copy this file to .env and fill in your own values.
# Anything set here is only used as a fallback for values not already
# present in your real environment variables (real env vars always win).
#
# .env is gitignored - only this .env.example template is committed.

DO_API_TOKEN=your-digitalocean-api-token
DOCONSOLE_SSH_KEY=/path/to/your/private/key
DOCONSOLE_PLAYBOOKS_DIR=/path/to/playbooks

# On by default. When on, 'create droplet' auto-uploads DOCONSOLE_SSH_KEY's
# matching .pub file to your DO account if it isn't registered there yet
# (matched by fingerprint, so it never re-uploads a key that's already
# present - that mismatch used to cause "duplicate key" errors). Set to
# false/0/no to disable.
DOCONSOLE_AUTO_UPLOAD_SSH_KEY=true
